# ---- Copy to .env (docker compose reads it automatically) ----

# LLM provider: fake (offline, default) | openai | anthropic | gemini | ollama
LLM_PROVIDER=fake
# Optional model override; defaults: anthropic=claude-opus-5-5, openai=gpt-4o-mini,
# gemini=gemini-2.0-flash, ollama=llama3.1
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embeddings: hash (offline, default) | openai | gemini | ollama
EMBEDDING_PROVIDER=hash
# Must match the pgvector column; changing it requires a fresh database / re-migration.
EMBEDDING_DIM=768

# Reranker: lexical (local, default) | cohere | none
RERANKER=lexical
COHERE_API_KEY=

# Security
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO in compose)
MINIO_ROOT_USER=documind
MINIO_ROOT_PASSWORD=documind-secret
# MINIO_IMAGE=coollabsio/minio:latest

# Public URL the browser uses to reach the API (baked into the frontend build)
PUBLIC_API_URL=http://localhost:8000

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5442
REDIS_PORT=6389
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
